@startuml Class_Diagram
!theme plain
skinparam backgroundColor #FEFEFE
skinparam defaultFontSize 11
skinparam shadowing false
skinparam classBackgroundColor #E8F5E9
skinparam classBorderColor #2E7D32
skinparam classHeaderBackgroundColor #C8E6C9

title **Smart Waste Collection Optimization — Class Diagram**

class DataLoader {
    - file_path : str
    - raw_data : DataFrame
    - is_loaded : bool
    __
    + __init__(file_path: str)
    + load_csv() : DataFrame
    + validate_data() : bool
    + handle_missing_values() : DataFrame
    + get_summary() : dict
    + get_shape() : tuple
    + get_column_types() : dict
}

class FeatureEngineer {
    - data : DataFrame
    - feature_columns : list
    - target_column : str
    - scaler : StandardScaler
    __
    + __init__(data: DataFrame, target: str)
    + extract_time_features() : DataFrame
    + extract_location_features() : DataFrame
    + calculate_rolling_avg(window: int) : DataFrame
    + encode_categorical() : DataFrame
    + normalize_features() : DataFrame
    + get_feature_matrix() : ndarray
    + get_target_vector() : ndarray
    + split_train_test(test_size: float) : tuple
}

class BinFillPredictor {
    - model : RandomForestClassifier
    - n_estimators : int
    - max_depth : int
    - test_size : float
    - is_trained : bool
    - metrics : dict
    __
    + __init__(n_estimators: int, max_depth: int)
    + train(X_train: ndarray, y_train: ndarray) : void
    + predict(X: ndarray) : ndarray
    + predict_proba(X: ndarray) : ndarray
    + evaluate(y_true: ndarray, y_pred: ndarray) : dict
    + get_feature_importance() : DataFrame
    + cross_validate(X: ndarray, y: ndarray, cv: int) : dict
    + tune_hyperparameters(X: ndarray, y: ndarray) : dict
    + save_model(path: str) : void
    + load_model(path: str) : void
}

class BinClusterer {
    - model : KMeans
    - n_clusters : int
    - cluster_centers : ndarray
    - labels : ndarray
    - inertia_scores : list
    __
    + __init__(n_clusters: int)
    + fit(coordinates: ndarray) : void
    + predict_cluster(new_point: ndarray) : int
    + get_cluster_centers() : ndarray
    + get_cluster_labels() : ndarray
    + calculate_silhouette_score() : float
    + find_optimal_k(max_k: int) : int
    + get_cluster_summary() : DataFrame
    + plot_elbow_curve() : void
}

class RouteOptimizer {
    - distance_matrix : ndarray
    - optimized_order : list
    - total_distance : float
    - savings_pct : float
    __
    + __init__()
    + haversine_distance(coord1: tuple, coord2: tuple) : float
    + calculate_distance_matrix(coords: ndarray) : ndarray
    + nearest_neighbor_route(start_idx: int) : list
    + calculate_total_distance(route: list) : float
    + optimize_per_cluster(clusters: dict) : dict
    + get_unoptimized_distance() : float
    + get_savings_percentage() : float
    + get_route_details() : list
}

class Visualizer {
    - output_dir : str
    - style : str
    __
    + __init__(output_dir: str)
    + plot_confusion_matrix(y_true, y_pred) : void
    + plot_feature_importance(importances: DataFrame) : void
    + plot_roc_curve(y_true, y_proba) : void
    + plot_classification_report(y_true, y_pred) : void
    + plot_clusters_on_map(coords, labels) : void
    + plot_optimized_route(route, coords) : void
    + plot_before_after_comparison() : void
    + plot_fill_level_distribution(data) : void
    + plot_elbow_curve(inertias: list) : void
    + plot_correlation_heatmap(data: DataFrame) : void
    + save_all_plots() : void
}

class Pipeline {
    - loader : DataLoader
    - engineer : FeatureEngineer
    - predictor : BinFillPredictor
    - clusterer : BinClusterer
    - optimizer : RouteOptimizer
    - visualizer : Visualizer
    - results : dict
    __
    + __init__(config: dict)
    + run_full_pipeline() : dict
    + run_prediction_stage() : list
    + run_optimization_stage(full_bins: list) : dict
    + generate_report() : void
    + get_results_summary() : dict
}

' ── Relationships ──

Pipeline *-- DataLoader : uses
Pipeline *-- FeatureEngineer : uses
Pipeline *-- BinFillPredictor : uses
Pipeline *-- BinClusterer : uses
Pipeline *-- RouteOptimizer : uses
Pipeline *-- Visualizer : uses

DataLoader ..> FeatureEngineer : "feeds data to"
FeatureEngineer ..> BinFillPredictor : "provides features to"
BinFillPredictor ..> BinClusterer : "passes full bins to"
BinClusterer ..> RouteOptimizer : "passes clusters to"
BinFillPredictor ..> Visualizer : "sends metrics to"
BinClusterer ..> Visualizer : "sends clusters to"
RouteOptimizer ..> Visualizer : "sends routes to"

@enduml
