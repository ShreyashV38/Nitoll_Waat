@startuml Use_Case_Diagram
!theme plain
skinparam backgroundColor #FEFEFE
skinparam actorStyle awesome
skinparam defaultFontSize 12
skinparam shadowing false
skinparam usecaseBackgroundColor #E8EAF6
skinparam usecaseBorderColor #3F51B5
skinparam nodesep 10
skinparam ranksep 20

title **Smart Waste Collection Optimization — Use Case Diagram**

left to right direction

actor "Admin / Municipality" as ADMIN
actor "Driver" as DRIVER
actor "Data Scientist" as DS
actor "ML System" as SYSTEM

rectangle "Smart Waste Collection System" {

    package "Data & ML Pipeline" {
        usecase "Upload Data" as UC1
        usecase "Clean Data" as UC2
        usecase "Engineer Features" as UC3
        usecase "Train Model (RF)" as UC4
        usecase "Retrain Model" as UC11
        usecase "Evaluate Model" as UC12
    }
    
    package "Predictions & Routing" {
        usecase "Predict Fill Levels" as UC5
        usecase "Cluster Bins" as UC6
        usecase "Optimize Route" as UC7
    }

    package "Operations & Monitoring" {
        usecase "View Map" as UC8
        usecase "View Metrics" as UC9
        usecase "Navigate Route" as UC10
    }
}

' Connections - kept direct to prevent spreading out
ADMIN --> UC1
ADMIN --> UC8
ADMIN --> UC9

DS --> UC2
DS --> UC3
DS --> UC4
DS --> UC11
DS --> UC12

SYSTEM --> UC5
SYSTEM --> UC6
SYSTEM --> UC7

DRIVER --> UC10

' Internal includes
UC1 ..> UC2 : <<include>>
UC4 ..> UC5 : <<include>>
UC5 ..> UC6 : <<include>>
UC6 ..> UC7 : <<include>>
UC11 ..> UC4 : <<extend>>

@enduml
