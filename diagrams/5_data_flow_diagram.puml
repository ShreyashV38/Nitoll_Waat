@startuml Data_Flow_Diagram_Level0
!theme plain
skinparam backgroundColor #FEFEFE
skinparam defaultFontSize 12
skinparam shadowing false

title **Data Flow Diagram — Level 0 (Context Diagram)**

' ── External Entities ──
rectangle "IoT Sensors /\nDataset Source" as EXT_SENSOR #E3F2FD
rectangle "Admin /\nMunicipality" as EXT_ADMIN #E8F5E9
rectangle "Driver" as EXT_DRIVER #FFF3E0

' ── Central Process ──
usecase "Smart Waste\nCollection\nOptimizer" as SYSTEM #FCE4EC

' ── Data Flows ──
EXT_SENSOR -right-> SYSTEM : "  Raw sensor readings\n  (fill %, temp, time, GPS)  "
SYSTEM -right-> EXT_ADMIN : "  Performance reports,\n  visualizations,\n  analytics  "
SYSTEM -down-> EXT_DRIVER : "  Optimized collection\n  routes  "
EXT_ADMIN -down-> SYSTEM : "  Configuration,\n  retrain trigger  "

@enduml

